# cosine-digger start and serve read this file from the folder you run them in. Its keys,
# like exported ones, win over keys you paste in the browser (Digger saves those in its data folder).
# Settings directory (also contains settings.json, below environment precedence).
COSINE_DIGGER_HOME=~/.cosine-digger
# Explicit DB override wins over the legacy ~/.cosine-taste/taste.db; otherwise home/taste.db.
# COSINE_DIGGER_DB=~/.cosine-digger/taste.db
# Required Cosine API token.
COSINE_API_TOKEN=
# Optional Discogs token for metadata and discovery.
DISCOGS_TOKEN=
# Optional Exa API key for web discovery.
EXA_API_KEY=
# Optional readable music library directory.
# COSINE_DIGGER_MUSIC_DIR=~/Music
# YouTube Music auth JSON (defaults to COSINE_DIGGER_HOME/ytmusic_auth.json).
# COSINE_DIGGER_YTMUSIC_AUTH=~/.cosine-digger/ytmusic_auth.json
# Daily discovery time, HH:MM.
COSINE_DIGGER_DAILY_TIME=06:00
# Weekly discovery day.
COSINE_DIGGER_WEEKLY_DAY=mon
# Weekly discovery time, HH:MM.
COSINE_DIGGER_WEEKLY_TIME=06:00
# Number of tracks in a daily discovery.
COSINE_DIGGER_DAILY_SIZE=20
# Number of tracks in a weekly discovery.
COSINE_DIGGER_WEEKLY_SIZE=50
# Web server bind address for serve (start always uses 127.0.0.1).
COSINE_DIGGER_HOST=127.0.0.1
# Web server port.
COSINE_DIGGER_PORT=8765
